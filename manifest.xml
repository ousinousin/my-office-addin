<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="TaskPaneApp">
  <!-- アドインの一意のID (GUID形式) -->
  <Id>12345678-1234-1234-1234-1234567890ab</Id>

  <!-- アドインのバージョン -->
  <Version>1.0.0.0</Version>

  <!-- 開発者名 -->
  <ProviderName>My Company</ProviderName>

  <!-- 使用するデフォルトのロケール -->
  <DefaultLocale>en-US</DefaultLocale>

  <!-- アドインの表示名 -->
  <DisplayName DefaultValue="My Office Add-in" />

  <!-- アドインの説明 -->
  <Description DefaultValue="A sample add-in for Word." />

  <!-- サポートするOfficeアプリケーション -->
  <Hosts>
    <Host Name="Document" />
  </Hosts>

  <!-- 要求セットバージョン -->
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="WordApi" MinVersion="1.3" />
    </Sets>
  </Requirements>

  <!-- タスクパネルの初期表示URL -->
  <DefaultSettings>
    <SourceLocation DefaultValue="https://ousinousin.github.io/my-office-addin/index.html" />
  </DefaultSettings>

  <!-- アドインの権限 -->
  <Permissions>ReadWriteDocument</Permissions>
</OfficeApp>
